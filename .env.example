DATABASE_URL=postgresql+psycopg://invoiceai:invoiceai-local@localhost:5432/invoiceai
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
POSTGRES_PASSWORD=invoiceai-local
DEMO_EMAIL=demo@invoiceai.local
DEMO_PASSWORD=Demo@123
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# OpenAI-compatible extraction (optional; deterministic document parsing is used otherwise)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI (optional alternative to OpenAI-compatible API)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Azure Document Intelligence OCR (optional; requires the endpoint and key together)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
